# Evidence AI - Environment Configuration Example
# Copy this file to .env and fill in your values. Do NOT commit .env to source control.

# Required: Secret key for signing session JWTs (minimum 32 characters)
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional: Session expiration in minutes (default: 30)
SESSION_MINUTES=30

# Optional: Set to true in production (requires HTTPS) (default: false)
COOKIE_SECURE=false

# Optional: Cookie SameSite policy ("lax", "strict", or "none") (default: lax)
COOKIE_SAMESITE=lax

# Optional: Allowed CORS origin for the frontend (default: http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173
