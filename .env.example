# Evidence AI — Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env

# -------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# SQLite default database path (relative to project root)
DATABASE_URL=sqlite:///./evidence_ai.db

# -------------------------------------------------------------
# Ollama & Local Vision-Language / LLM Inference
# -------------------------------------------------------------
# Base URL for locally running Ollama daemon
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Vision-Language Model for multimodal image semantic understanding
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct

# Text Model for event extraction, case understanding, and timeline analysis
OLLAMA_MODEL=qwen2.5:3b

# Vision analysis feature flag (1 = enabled, 0 = disabled)
EVIDENCE_AI_ENABLE_VISION=1

# Max image edge dimension in pixels for VRAM-constrained inference (bounds VRAM on 6 GB GPUs)
VISION_MAX_IMAGE_EDGE=1024

# Timeouts in seconds for model inference
VISION_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=60

# -------------------------------------------------------------
# Storage & Model Cache Paths
# -------------------------------------------------------------
STORAGE_DIR=storage/originals
MODELS_CACHE_DIR=models_cache

# -------------------------------------------------------------
# Server Network Settings
# -------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
